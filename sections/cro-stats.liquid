{{ 'cro-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-landing.js' | asset_url }}" defer></script>

<section
  class="cro-section"
  style="
    --cro-accent: {{ section.settings.accent_color }};
    --cro-accent-soft: {{ section.settings.row_background }};
    --cro-accent-line: {{ section.settings.track_color }};
    background: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cro-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="cro-h2 cro-reveal" style="text-align: center; margin-bottom: 24px;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <cro-stats class="cro-stats">
      {%- for block in section.blocks -%}
        <div
          class="cro-stats__row cro-reveal"
          data-percent="{{ block.settings.percent }}"
          style="--cro-i: {{ forloop.index0 }}; --cro-shown: 0;"
          {{ block.shopify_attributes }}
        >
          <div class="cro-stats__circle">
            <span class="cro-stats__num" data-cro-count>0%</span>
          </div>
          <div class="cro-stats__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </cro-stats>
  </div>
</section>

{% schema %}
{
  "name": "CRO — Statistika",
  "tag": "section",
  "class": "cro-shopify-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov sekcije" },
    { "type": "color", "id": "accent_color", "label": "Akcentna boja", "default": "#f69906" },
    { "type": "color", "id": "row_background", "label": "Pozadina reda", "default": "#fffaf2" },
    { "type": "color", "id": "track_color", "label": "Boja prstena", "default": "#fbebd5" },
    { "type": "color", "id": "background_color", "label": "Pozadina sekcije", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Razmak gore", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Razmak dole", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "stat", "name": "Statistika",
      "settings": [
        { "type": "range", "id": "percent", "label": "Procenat", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 95 },
        { "type": "html", "id": "text", "label": "Tekst", "default": "korisnika kaže da je fotelja <strong>izuzetno udobna</strong>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO — Statistika",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
