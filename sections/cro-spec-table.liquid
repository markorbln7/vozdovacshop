{{ 'cro-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-landing.js' | asset_url }}" defer></script>

<section
  class="cro-section"
  style="
    --cro-accent: {{ section.settings.accent_color }};
    --cro-accent-soft: {{ section.settings.name_background }};
    --cro-accent-line: {{ section.settings.border_color }};
    background: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cro-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="cro-h2 cro-reveal" style="text-align: {{ section.settings.heading_alignment }}; margin-bottom: 20px;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="cro-spec cro-reveal">
      <table class="cro-spec__table">
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td class="cro-spec__name">{{ block.settings.name }}</td>
              <td class="cro-spec__value">{{ block.settings.value }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- if section.settings.disclaimer != blank -%}
        <p class="cro-spec__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CRO — Specifikacija",
  "tag": "section",
  "class": "cro-shopify-section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov sekcije" },
    {
      "type": "select", "id": "heading_alignment", "label": "Poravnanje naslova", "default": "left",
      "options": [{ "value": "left", "label": "Levo" }, { "value": "center", "label": "Centrirano" }]
    },
    { "type": "text", "id": "disclaimer", "label": "Napomena ispod tabele" },
    { "type": "color", "id": "accent_color", "label": "Akcentna boja", "default": "#f69906" },
    { "type": "color", "id": "name_background", "label": "Pozadina leve kolone", "default": "#fffaf2" },
    { "type": "color", "id": "border_color", "label": "Boja linija", "default": "#fbebd5" },
    { "type": "color", "id": "background_color", "label": "Pozadina sekcije", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Razmak gore", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Razmak dole", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "row", "name": "Red",
      "settings": [
        { "type": "text", "id": "name", "label": "Naziv", "default": "Materijal" },
        { "type": "html", "id": "value", "label": "Vrednost", "default": "Mekana tkanina prijatna na dodir" }
      ]
    }
  ],
  "presets": [{ "name": "CRO — Specifikacija", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
