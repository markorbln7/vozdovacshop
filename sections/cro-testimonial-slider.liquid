{{ 'cro-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-landing.js' | asset_url }}" defer></script>

<section
  class="cro-section"
  style="
    --cro-accent: {{ section.settings.accent_color }};
    --cro-highlight-color: {{ section.settings.highlight_color }};
    background: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cro-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="cro-h2 cro-reveal" style="text-align: center; margin-bottom: 22px;">
        {%- if section.settings.highlight_words != blank -%}
          {%- capture cro_hl -%}<span class="cro-highlight">{{ section.settings.highlight_words }}</span>{%- endcapture -%}{{ section.settings.heading | replace: section.settings.highlight_words, cro_hl }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    <cro-slider
      class="cro-slider cro-reveal"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
      style="--cro-per-view-desktop: {{ section.settings.columns }}; --cro-slide-gap-desktop: {{ section.settings.gap }}px;"
    >
      <ul class="cro-slider__track" role="list">
        {%- for block in section.blocks -%}
          <li class="cro-slider__slide" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.alt | default: 'Utisak kupca',
                  sizes: '(min-width: 750px) 33vw, 90vw'
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.alt | escape }}"
                width="{{ block.settings.image_width }}"
                height="{{ block.settings.image_height }}"
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <button class="cro-slider__arrow cro-slider__arrow--prev" type="button" aria-label="Prethodni utisak">
          <svg viewBox="0 0 10 16" aria-hidden="true"><path d="M9.4 1.6 8 .2 0 8l8 7.8 1.4-1.4L2.8 8z"/></svg>
        </button>
        <button class="cro-slider__arrow cro-slider__arrow--next" type="button" aria-label="Sledeći utisak">
          <svg viewBox="0 0 10 16" aria-hidden="true"><path d="M9.4 1.6 8 .2 0 8l8 7.8 1.4-1.4L2.8 8z"/></svg>
        </button>
        <div class="cro-slider__dots">
          {%- for block in section.blocks -%}
            <button
              class="cro-slider__dot"
              type="button"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Idi na utisak {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </cro-slider>
  </div>
</section>

{% schema %}
{
  "name": "CRO — Utisci (slajder)",
  "tag": "section",
  "class": "cro-shopify-section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov", "default": "Šta drugi kažu o nama?" },
    { "type": "text", "id": "highlight_words", "label": "Reči koje se ističu" },
    { "type": "range", "id": "columns", "label": "Slajdova na desktopu", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Razmak", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 28 },
    { "type": "checkbox", "id": "autoplay", "label": "Automatsko pomeranje", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Pauza između slajdova", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 7 },
    { "type": "color", "id": "accent_color", "label": "Akcentna boja", "default": "#f69906" },
    { "type": "color", "id": "highlight_color", "label": "Boja markera", "default": "#e9d5f5" },
    { "type": "color", "id": "background_color", "label": "Pozadina", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Razmak gore", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Razmak dole", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Utisak",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slika" },
        { "type": "text", "id": "image_url", "label": "Slika sa linka (URL)" },
        { "type": "number", "id": "image_width", "label": "Originalna širina (px)", "default": 1080 },
        { "type": "number", "id": "image_height", "label": "Originalna visina (px)", "default": 1350 },
        { "type": "text", "id": "alt", "label": "Opis slike" }
      ]
    }
  ],
  "presets": [{ "name": "CRO — Utisci (slajder)", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
