{{ 'cro-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-landing.js' | asset_url }}" defer></script>

<section
  class="cro-section"
  style="
    --cro-accent: {{ section.settings.accent_color }};
    --cro-highlight-color: {{ section.settings.highlight_color }};
    background: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cro-page-width" style="max-width: {{ section.settings.max_width }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="cro-h2 cro-reveal" style="text-align: center; margin-bottom: 24px;">
        {%- if section.settings.highlight_words != blank -%}
          {%- capture cro_hl -%}<span class="cro-highlight">{{ section.settings.highlight_words }}</span>{%- endcapture -%}{{ section.settings.heading | replace: section.settings.highlight_words, cro_hl }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    <div class="cro-faq">
      {%- for block in section.blocks -%}
        <details
          class="cro-faq__item cro-reveal"
          style="--cro-i: {{ forloop.index0 }};"
          {% if block.settings.open_by_default %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="cro-faq__summary">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 90 | image_tag: loading: 'lazy', alt: '', class: 'cro-faq__icon' }}
            {%- elsif section.settings.default_icon != blank -%}
              {{ section.settings.default_icon | image_url: width: 90 | image_tag: loading: 'lazy', alt: '', class: 'cro-faq__icon' }}
            {%- elsif section.settings.default_icon_url != blank -%}
              <img class="cro-faq__icon" src="{{ section.settings.default_icon_url }}" alt="" width="90" height="90" loading="lazy" decoding="async">
            {%- endif -%}
            <h3 class="cro-faq__q">{{ block.settings.question }}</h3>
            <svg class="cro-faq__caret" viewBox="0 0 10 6" aria-hidden="true">
              <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"/>
            </svg>
          </summary>
          <div class="cro-faq__answer">
            <div class="cro-faq__answer-inner cro-rte">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CRO — Česta pitanja",
  "tag": "section",
  "class": "cro-shopify-section",
  "max_blocks": 15,
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov", "default": "Često postavljana pitanja" },
    { "type": "text", "id": "highlight_words", "label": "Reči koje se ističu" },
    { "type": "image_picker", "id": "default_icon", "label": "Podrazumevana ikona pitanja" },
    { "type": "text", "id": "default_icon_url", "label": "Ikona pitanja — URL" },
    { "type": "range", "id": "max_width", "label": "Maksimalna širina", "min": 600, "max": 1400, "step": 50, "unit": "px", "default": 900 },
    { "type": "color", "id": "accent_color", "label": "Akcentna boja", "default": "#f69906" },
    { "type": "color", "id": "highlight_color", "label": "Boja markera", "default": "#e9d5f5" },
    { "type": "color", "id": "background_color", "label": "Pozadina", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Razmak gore", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Razmak dole", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "question", "name": "Pitanje",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Ikona" },
        { "type": "text", "id": "question", "label": "Pitanje", "default": "Koliko traje isporuka?" },
        { "type": "richtext", "id": "answer", "label": "Odgovor" },
        { "type": "checkbox", "id": "open_by_default", "label": "Otvoreno po ulasku", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "CRO — Česta pitanja", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
