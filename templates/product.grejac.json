    "faq": {
      "type": "cro-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Koliko brzo se zagreje?",
            "answer": "<p>Već posle <strong>nekoliko minuta</strong> od uključivanja osetićete toplotu ispod celog stopala. Plišani gornji deo i krzno na ivici zadržavaju toplotu unutra.</p>",
            "open_by_default": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Da li mogu da koristim samo grejanje, bez masaže?",
            "answer": "<p>Da. Grejanje i masaža imaju <strong>posebna dugmad</strong>, pa birate samo toplotu, samo masažu ili oboje u isto vreme.</p>",
            "open_by_default": false
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Kako se koristi kao jastuk za vrat?",
            "answer": "<p>Gornji deo otvorite i skinete pomoću <strong>rajsferšlusa</strong>. Ostaje ravna podloga koju koristite kao jastuk za vrat, oslonac za leđa dok sedite ili grejač za ruke i stomak.</p>",
            "open_by_default": false
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Da li odgovara za sve veličine stopala?",
            "answer": "<p>Grejač je širok i mekan, pa u njega staju <strong>oba stopala odjednom</strong> — i ženska i muška. Plišani materijal se prilagođava obliku stopala.</p>",
            "open_by_default": false
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Ko ne bi trebalo da ga koristi?",
            "answer": "<p>Osobe sa dijabetesom, oštećenjem nerava u stopalima, problemima sa cirkulacijom, trudnice i osobe sa pejsmejkerom pre upotrebe treba da se <strong>posavetuju sa lekarom</strong>. Ne preporučuje se spavanje sa uključenim grejačem.</p>",
            "open_by_default": false
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Mogu li da platim pouzećem?",
            "answer": "<p>Da. Paket plaćate kuriru pri preuzimanju — bez kartice i bez avansa. Porudžbine primljene do 14h šaljemo istog dana, isporuka je za <strong>1–2 radna dana</strong>.</p>",
            "open_by_default": false
          }
        }
